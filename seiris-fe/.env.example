# ─── SEIRIS — Frontend Environment ─────────────────────────────
#
# Copy this file to .env and fill in your values.
#
# VPS SETUP:
#   VITE_API_BASE_URL=https://domainkamu.com/api
#   VITE_PUSHER_APP_KEY / CLUSTER → sama dengan backend .env
#
# ───────────────────────────────────────────────────────────────

# Nama aplikasi (tampil di title bar)
VITE_APP_NAME="SEIRIS Frontend"

# URL backend API — ganti sesuai server (VPS: https://domainkamu.com/api)
VITE_API_BASE_URL=http://localhost:8000/api

# Pusher — wajib untuk realtime (timeline equity, kontribusi, presence)
# Isi dari dashboard pusher.com, HARUS SAMA dengan backend .env
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=ap1
