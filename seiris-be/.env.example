# ─── SEIRIS — Backend Environment ─────────────────────────────────
#
# Copy this file to .env and fill in your values.
#
# VPS QUICK SETUP:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://domainkamu.com
#   DB_HOST=localhost
#   DB_PASSWORD=<isi password postgres>
#   BROADCAST_CONNECTION=pusher  → wajib untuk fitur realtime
#   PUSHER_APP_ID / KEY / SECRET / CLUSTER  → dari dashboard pusher.com
#   MAX_STUDENT_FMR=150000  (sesuaikan kebijakan)
#
# ────────────────────────────────────────────────────────────────

APP_NAME=SEIRIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ──────────────────────────────────────────────────
# SEIRIS WAJIB PostgreSQL — migrasi pakai uuid() helper (Laravel)
# dan lockForUpdate() untuk pessimistic locking.
# SQLite/MySQL akan gagal atau no-op (race condition!).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=seiris
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Broadcasting & Queue ──────────────────────────────────────
# BROADCAST_CONNECTION=pusher  untuk fitur realtime (timeline equity,
#   kontribusi baru, presence anggota online).
#   Saat development bisa pakai BROADCAST_CONNECTION=log (tidak realtime).
# QUEUE_CONNECTION=database  — default, jangan diganti.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Pusher (BROADCAST_CONNECTION=pusher) ──────────────────────
# Daftar/ login di https://pusher.com → buat Channels app → isi dari dashboard.
# Wajib diisi kalau mau fitur realtime (timeline equity, presence, dll).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

# ─── AWS (opsional, untuk S3/media) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── SEIRIS Configuration ──────────────────────────────────────
# Maksimum Fair Market Rate per jam untuk anggota (mahasiswa).
# Nilai ini dipakai oleh SlicingPieService — di atas batas akan 422.
MAX_STUDENT_FMR=150000

VITE_APP_NAME="${APP_NAME}"
